{
  "name": "shoutlink",
  "version": "0.3.0",
  "private": true,
  "description": "返礼リンク — ライブリダイレクトの受信や登録者のコメントを検知して、相手のチャンネル URL をライブチャットへ投稿する Chrome 拡張 (MV3)",
  "type": "module",
  "engines": {
    "node": ">=20.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --release && node scripts/package.mjs",
    "package:store": "node scripts/build.mjs --release && node scripts/package-store.mjs",
    "icons": "node scripts/make-icons.mjs",
    "site-assets": "node scripts/build.mjs && node scripts/make-site-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-links": "node scripts/check-links.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-enterme/shoutlink.git"
  },
  "homepage": "https://max-enterme.github.io/shoutlink/",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^26.4.1",
    "esbuild": "^0.23.1",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
