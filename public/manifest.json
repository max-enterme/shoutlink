{
  "manifest_version": 3,
  "name": "返礼リンク (shoutlink)",
  "version": "0.3.0",
  "description": "配信中に受け取ったライブリダイレクトや、登録した人のコメントを検知して、その人のチャンネル URL をライブチャットへ投稿します。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["https://studio.youtube.com/*", "https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://studio.youtube.com/live_chat*"],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "返礼リンク (設定は拡張機能のオプションから)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
